# Local spider project used by the person_crawl_agent (X / Weibo corpora).
SPIDER_BASE_PATH=~/GitHub/spider

# Optional shared private LLM settings. Project-local values still win.
# LLM_SHARED_ENV_FILE=~/.config/llm/shared.env

# Mock mode needs no keys:
# python main.py --topic "AI 会不会取代程序员" --council experts --rounds 2 --mock

# Gemini API config. Multiple keys are tried in numeric order.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=4096

# OpenAI placeholder config.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT=60
OPENAI_MAX_OUTPUT_TOKENS=4096

# OpenRouter placeholder config.
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free,poolside/laguna-m.1:free,nvidia/nemotron-3-super-120b-a12b:free,openai/gpt-oss-120b:free
OPENROUTER_TIMEOUT=60
OPENROUTER_MAX_OUTPUT_TOKENS=4096

# DeepSeek uses an OpenAI-compatible API.
# Current account models are refreshed through llm-gateway models.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=60
DEEPSEEK_MAX_OUTPUT_TOKENS=4096

# Claude/Codex always use their official local CLI subscription login state.
# Their executable names and transport are fixed by llm_gateway and cannot be
# overridden to another binary, HTTP, or an SDK.
CLAUDE_CLI_TIMEOUT=600
CODEX_CLI_TIMEOUT=600
CLI_SUBPROCESS_TIMEOUT=600

# CLIProxyAPI address/key are discovered from ~/.cli-proxy-api/config.yaml.
CLI_PROXY_TIMEOUT=600
